# Shared password for /admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Random secret used to sign session cookies (e.g. openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-string

# GitHub PAT with Contents: read and write on the repository.
# Required in production. Leave unset locally to write directly to disk.
CMS_GITHUB_TOKEN=

# Optional overrides
CMS_GITHUB_REPO=prashamghimire/portfolio
CMS_GITHUB_BRANCH=main
